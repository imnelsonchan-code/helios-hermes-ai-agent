# Copy to .env (gitignored). Never commit real secrets.

# Hermes layout
HERMES_HOME=$HOME/.hermes
HERMES_CLI=$HOME/.hermes/hermes-agent/venv/bin/hermes
REPORTS_INBOX=$HOME/workspace/reports/inbox
REPORTS_WWW=$HOME/web-infra/reports-server/www
REPORTS_ARCHIVE=$HOME/web-infra/reports-server/archive
# Bind the reports portal to loopback by default; open to LAN deliberately if needed.
REPORTS_BIND=127.0.0.1

# OpenViking memory / KB
OPENVIKING_ENDPOINT=http://127.0.0.1:1933
OPENVIKING_API_KEY=CHANGE_ME_MATCH_OV_CONF_ROOT_KEY
# OPENVIKING_PUBLIC_BASE_URL=

# Browser / crawl / search (Docker templates under web-infra/)
BROWSERLESS_TOKEN=CHANGE_ME
CRAWL4AI_API_TOKEN=CHANGE_ME
SEARXNG_SECRET_KEY=CHANGE_ME

# Optional OmniRoute (web-infra/omniroute/)
# APP_BIND_HOST=0.0.0.0
# DASHBOARD_PORT=20128
# API_PORT=20129
