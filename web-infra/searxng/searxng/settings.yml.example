# Minimal SearXNG starter. Prefer the upstream default settings.yml from
# https://github.com/searxng/searxng and only override what you need.
# Copy to settings.yml next to this file before `docker compose up`.

use_default_settings: true

general:
  instance_name: "Hermes SearXNG"

server:
  # Must match SEARXNG_SECRET_KEY / a strong random value
  secret_key: "CHANGE_ME_LONG_RANDOM"
  limiter: false
  image_proxy: true

search:
  safe_search: 0
  autocomplete: ""
  default_lang: "en"

ui:
  static_use_hash: true
