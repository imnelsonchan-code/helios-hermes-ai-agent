{
  "storage": {
    "workspace": "/var/lib/openviking/workspace"
  },
  "server": {
    "host": "0.0.0.0",
    "port": 1933,
    "auth_mode": "api_key",
    "root_api_key": "CHANGE_ME_LONG_RANDOM"
  },
  "embedding": {
    "dense": {
      "provider": "gemini",
      "api_key": "YOUR_EMBEDDING_API_KEY",
      "model": "gemini-embedding-001",
      "dimension": 768
    }
  },
  "vlm": {
    "provider": "openai",
    "api_key": "YOUR_VLM_API_KEY",
    "api_base": "https://api.example.com/v1",
    "model": "your-chat-model"
  }
}
