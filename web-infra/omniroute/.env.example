# OmniRoute host env — copy to .env on the Hermes host (never commit .env).
# apply-omniroute.sh generates JWT_SECRET / API_KEY_SECRET / INITIAL_PASSWORD
# when missing. Mint a separate client API key in the dashboard for Hermes.

# ── Bind / ports (internal network) ───────────────────────────────────
# 0.0.0.0 = reachable from other servers on the internal LAN.
# Keep REQUIRE_API_KEY=true. Do not put a public reverse proxy in front for v1.
APP_BIND_HOST=0.0.0.0
DASHBOARD_PORT=20128
API_PORT=20129
LIVE_WS_PORT=20132

# ── Auth ──────────────────────────────────────────────────────────────
REQUIRE_API_KEY=true
# Generated on first apply if empty:
JWT_SECRET=
API_KEY_SECRET=
INITIAL_PASSWORD=

# ── Runtime ───────────────────────────────────────────────────────────
OMNIROUTE_MEMORY_MB=2048

# Free-list overlay (built-in Radar scheduler; no extra host cron).
# After boot: open dashboard → Radar → opt in to feed sync.
RADAR_ENABLED=true
